generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String // ADMIN | GURU | SISWA | KEPSEK | KURIKULUM
  nip       String?
  nis       String?
  phone     String?
  gender    String?
  avatar    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  kelasDiajar Kelas[]    @relation("GuruKelas")
  kelasDiikuti Kelas[]    @relation("SiswaKelas")
  tugasDibuat  Tugas[]    @relation("GuruTugas")
  pengumpulan  Pengumpulan[]
  nilaiDiberi  Nilai[]     @relation("GuruNilai")
  nilai        Nilai[]     @relation("SiswaNilai")
  absensi      Absensi[]
  pengumuman   Pengumuman[]
  modulAjar    ModulAjar[]
}

model Kelas {
  id     String @id @default(cuid())
  nama   String
  tingkat String
  tahun  String
  wali   String?

  guru    User? @relation("GuruKelas", fields: [guruId], references: [id])
  guruId  String?
  siswa   User[] @relation("SiswaKelas")
  mapel   Mapel[]
  jadwal  Jadwal[]
  tugas   Tugas[]
  modulAjar ModulAjar[]
}

model Mapel {
  id       String @id @default(cuid())
  nama     String
  kode     String @unique
  deskripsi String?
  guruId   String?

  kelas Kelas[]
  jadwal Jadwal[]
  tugas Tugas[]
  capaian Capaian[]
  modulAjar ModulAjar[]
}

model Jadwal {
  id      String @id @default(cuid())
  hari    String
  jamMulai String
  jamSelesai String
  ruangan String?

  kelasId String
  mapelId String
  kelas   Kelas @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  mapel   Mapel @relation(fields: [mapelId], references: [id], onDelete: Cascade)
}

model Tugas {
  id          String   @id @default(cuid())
  judul       String
  deskripsi   String
  deadline    DateTime
  lampiran    String?
  dibuatPada  DateTime @default(now())

  guruId String
  kelasId String
  mapelId String
  guru   User  @relation("GuruTugas", fields: [guruId], references: [id])
  kelas   Kelas @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  mapel   Mapel @relation(fields: [mapelId], references: [id])

  pengumpulan Pengumpulan[]
  nilai       Nilai[]
}

model Pengumpulan {
  id        String   @id @default(cuid())
  file      String?
  catatan   String?
  nilaiAkhir Float?
  submitPada DateTime @default(now())

  tugasId String
  siswaId String
  tugas   Tugas @relation(fields: [tugasId], references: [id], onDelete: Cascade)
  siswa   User  @relation(fields: [siswaId], references: [id], onDelete: Cascade)
}

model Nilai {
  id        String @id @default(cuid())
  tipe      String // UTS | UAS | TUGAS | HARIAN
  semester  Int    @default(1)
  nilai     Float
  catatan   String?

  siswaId String
  tugasId String?
  guruId  String
  siswa   User  @relation("SiswaNilai", fields: [siswaId], references: [id], onDelete: Cascade)
  tugas   Tugas? @relation(fields: [tugasId], references: [id])
  guru    User  @relation("GuruNilai", fields: [guruId], references: [id])
}

model Absensi {
  id       String @id @default(cuid())
  tanggal  DateTime
  status   String // HADIR | IZIN | SAKIT | ALFA
  catatan  String?

  siswaId String
  siswa   User @relation(fields: [siswaId], references: [id], onDelete: Cascade)

  @@unique([siswaId, tanggal])
}

model Pengumuman {
  id     String @id @default(cuid())
  judul  String
  isi    String
  target String // SEMUA | GURU | SISWA | KEPSEK | KURIKULUM
  dibuatPada DateTime @default(now())

  authorId String
  author   User @relation(fields: [authorId], references: [id])
}

/// Capaian Pembelajaran (CP) per mata pelajaran & fase.
model Capaian {
  id        String @id @default(cuid())
  fase      String // A | B | C | D | E | F
  deskripsi String
  mapelId   String
  mapel     Mapel @relation(fields: [mapelId], references: [id], onDelete: Cascade)
  tujuan    Tujuan[]
}

/// Tujuan Pembelajaran (TP) di bawah satu CP.
model Tujuan {
  id        String @id @default(cuid())
  deskripsi String
  urutan    Int    @default(1)
  capaianId String
  capaian   Capaian @relation(fields: [capaianId], references: [id], onDelete: Cascade)
  atp       Atp[]
}

/// Alur Tujuan Pembelajaran (ATP) di bawah satu TP.
model Atp {
  id       String  @id @default(cuid())
  judul    String
  alokasi  String?
  urutan   Int     @default(1)
  tujuanId String
  tujuan   Tujuan @relation(fields: [tujuanId], references: [id], onDelete: Cascade)
}

/// Modul ajar / perangkat pembelajaran yang disusun guru.
model ModulAjar {
  id        String   @id @default(cuid())
  judul     String
  status    String   @default("DRAFT") // DRAFT | REVIEW | SELESAI
  file      String?
  dibuatPada DateTime @default(now())

  mapelId String
  kelasId String?
  guruId  String
  mapel   Mapel @relation(fields: [mapelId], references: [id], onDelete: Cascade)
  kelas   Kelas? @relation(fields: [kelasId], references: [id], onDelete: SetNull)
  guru    User  @relation(fields: [guruId], references: [id], onDelete: Cascade)
}

/// Agenda kalender akademik sekolah.
model KalenderAkademik {
  id         String    @id @default(cuid())
  judul      String
  jenis      String    // KEGIATAN | UJIAN | LIBUR | RAPAT
  mulai      DateTime
  selesai    DateTime?
  keterangan String?
}
